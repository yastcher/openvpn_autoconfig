# === REQUIRED ===
VPN_SERVER_IP=YOUR_SERVER_IP

# === OPTIONAL ===
# External port (default 443)
VPN_PORT=443

# IPv6 subnet for VPN clients (NAT66). Leave empty to disable IPv6.
# Use any ULA prefix (fd00::/8 range, RFC 4193) — analogous to 10.x.x.x for IPv4.
# The /64 mask is required by OpenVPN for per-client address assignment.
# Example: fd00:0:0:1::/64
VPN_IPV6_SUBNET=
